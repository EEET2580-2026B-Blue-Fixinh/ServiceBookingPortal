# Copy this file to .env to get these defaults locally — .env itself is
# gitignored so each developer's copy can diverge without touching git.

# Where the backend lives. Leave commented to use the default,
# http://localhost:8443/api/v1 — set it once the team's self-signed cert is in
# place and the dev profile starts serving https.
# VITE_API_URL=http://localhost:8443/api/v1

# The real-time notification channel (SockJS, so http rather than ws). Leave
# commented to use the default; change it together with VITE_API_URL.
# VITE_WS_URL=http://localhost:8443/ws

# Shows the "Demo account" click-to-fill box on the login page.
# Set to "false" (or remove this line) before shipping to production.
VITE_SHOW_DEMO_ACCOUNT=true

# The seeded accounts that box fills in. The box hides itself when the customer
# address is blank, so leaving these empty simply turns the shortcut off. These
# VITE_* values are public in every production bundle: never put a real password
# in them, and do not create these four variables in the Vercel Production env.
VITE_DEMO_CUSTOMER_EMAIL=an.nguyen@gmail.com
VITE_DEMO_CUSTOMER_PASSWORD=Fixinh@2025
VITE_DEMO_ADMIN_EMAIL=admin@fixinh.vn
VITE_DEMO_ADMIN_PASSWORD=Admin@2025
