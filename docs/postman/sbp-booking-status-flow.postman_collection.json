{
  "info": {
    "name": "SBP · Deployed booking status flow (mock SMP events)",
    "description": "FE-first demo against deployed SBP on Render: create the booking in the frontend, then use Postman only to simulate SMP status events CREATED -> CONFIRMED -> SCHEDULED -> WORKING -> COMPLETED. No request creates a booking or calls localhost/SMT. The event steps write real booking and notification data on the deployed backend.\n\nBefore running:\n1. Verify Render uses SMP_MODE=mock (the repo's Render blueprint default). Do not run simulated events if Render is in live mode.\n2. Configure a non-development SMP_WEBHOOK_SECRET on Render and fill smpSecret with the same value in Postman.\n3. Sign in to https://fixinh-service-booking-portal.vercel.app/ and create a booking using New booking. Copy the full Booking reference (ORD-YYYY-NNNN) from the confirmation screen or My bookings into the bookingRef collection variable.\n4. Fill customerEmail and customerPassword for that SAME customer account in Postman.\n\nSend requests one at a time: 0 logs in, 1 verifies the FE booking is CREATED, 2 pushes CONFIRMED, and 3 pushes SCHEDULED. Send 4 to push WORKING and Check WORKING, then pause and refresh the FE booking page to show the Working stage. Only after that send 5 to push COMPLETED, then Check A/B and refresh FE again. Do not Run the entire collection at once or the Working stage will disappear immediately. Do not run events against a real customer's booking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "sbpBaseUrl", "value": "https://fixinh-sbp-api.onrender.com/api/v1" },
    { "key": "customerEmail", "value": "" },
    { "key": "customerPassword", "value": "" },
    { "key": "smpSecret", "value": "" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "bookingRef", "value": "" },
    { "key": "scheduledStartAt", "value": "" },
    { "key": "estimatedDurationMinutes", "value": "120" },
    { "key": "technicians", "value": "[{\"technicianId\":\"TECH-002\",\"fullName\":\"Demo Technician\"}]" },
    { "key": "completedServiceFee", "value": "500000" },
    { "key": "materialCost", "value": "150000" },
    { "key": "totalCost", "value": "650000" }
  ],
  "item": [
    {
      "name": "0 · [SBP] Login (customer)",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
        "pm.collectionVariables.unset('token');",
        "pm.collectionVariables.unset('customerId');"
      ] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('token issued for a CUSTOMER', () => {",
        "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
        "  pm.expect(body.user.role).to.eql('CUSTOMER');",
        "});",
        "pm.collectionVariables.set('token', body.accessToken);",
        "pm.collectionVariables.set('customerId', body.user.userId);"
      ] } }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
        "url": { "raw": "{{sbpBaseUrl}}/auth/login", "host": ["{{sbpBaseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "1 · [SBP] Verify the booking created in FE",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
        "pm.collectionVariables.unset('scheduledStartAt');"
      ] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK — same customer owns this booking', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('bookingRef matches FE', () => pm.expect(body.bookingRef).to.eql(pm.variables.get('bookingRef')));",
        "pm.test('booking is CREATED', () => pm.expect(body.status).to.eql('CREATED'));",
        "const scheduledAt = new Date(`${body.preferredServiceDate}T${body.availableStartTime}+07:00`);",
        "pm.collectionVariables.set('scheduledStartAt', scheduledAt.toISOString());",
        "console.log('FE booking', body.bookingRef, 'schedule ->', scheduledAt.toISOString());"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{sbpBaseUrl}}/bookings/{{bookingRef}}", "host": ["{{sbpBaseUrl}}"], "path": ["bookings", "{{bookingRef}}"] }
      }
    },
    {
      "name": "2 · [Mock SMP → SBP] Push CONFIRMED",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('202 Accepted, not a duplicate', () => {",
        "  pm.response.to.have.status(202);",
        "  pm.expect(pm.response.json()).to.include({ accepted: true, duplicate: false });",
        "});"
      ] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{smpSecret}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"evt-{{$guid}}\",\n  \"eventType\": \"BOOKING_STATUS_CHANGED\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"bookingRef\": \"{{bookingRef}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"payload\": {\n    \"status\": \"CONFIRMED\",\n    \"estimatedDurationMinutes\": {{estimatedDurationMinutes}}\n  }\n}" },
        "url": { "raw": "{{sbpBaseUrl}}/integration/booking-events", "host": ["{{sbpBaseUrl}}"], "path": ["integration", "booking-events"] }
      }
    },
    {
      "name": "3 · [Mock SMP → SBP] Push SCHEDULED",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('202 Accepted, not a duplicate', () => {",
        "  pm.response.to.have.status(202);",
        "  pm.expect(pm.response.json()).to.include({ accepted: true, duplicate: false });",
        "});"
      ] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{smpSecret}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"evt-{{$guid}}\",\n  \"eventType\": \"TECHNICIAN_ASSIGNED\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"bookingRef\": \"{{bookingRef}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"payload\": {\n    \"status\": \"SCHEDULED\",\n    \"scheduledStartAt\": \"{{scheduledStartAt}}\",\n    \"estimatedDurationMinutes\": {{estimatedDurationMinutes}},\n    \"technicians\": {{technicians}}\n  }\n}" },
        "url": { "raw": "{{sbpBaseUrl}}/integration/booking-events", "host": ["{{sbpBaseUrl}}"], "path": ["integration", "booking-events"] }
      }
    },
    {
      "name": "4 · [Mock SMP → SBP] Push WORKING",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('202 Accepted, not a duplicate', () => {",
        "  pm.response.to.have.status(202);",
        "  pm.expect(pm.response.json()).to.include({ accepted: true, duplicate: false });",
        "});"
      ] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{smpSecret}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"evt-{{$guid}}\",\n  \"eventType\": \"BOOKING_STATUS_CHANGED\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"bookingRef\": \"{{bookingRef}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"payload\": {\n    \"status\": \"WORKING\"\n  }\n}" },
        "url": { "raw": "{{sbpBaseUrl}}/integration/booking-events", "host": ["{{sbpBaseUrl}}"], "path": ["integration", "booking-events"] }
      }
    },
    {
      "name": "Check WORKING · [SBP] Booking is in progress before completion",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('status is WORKING', () => pm.expect(body.status).to.eql('WORKING'));",
        "const expectedTechnicians = JSON.parse(pm.collectionVariables.get('technicians'));",
        "pm.test('scheduled technicians are retained', () => {",
        "  pm.expect(body.technicians.map(t => t.fullName)).to.have.members(expectedTechnicians.map(t => t.fullName));",
        "});"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{sbpBaseUrl}}/bookings/{{bookingRef}}", "host": ["{{sbpBaseUrl}}"], "path": ["bookings", "{{bookingRef}}"] }
      }
    },
    {
      "name": "5 · [Mock SMP → SBP] Push COMPLETED with the bill",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('202 Accepted, not a duplicate', () => {",
        "  pm.response.to.have.status(202);",
        "  pm.expect(pm.response.json()).to.include({ accepted: true, duplicate: false });",
        "});"
      ] } }],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{smpSecret}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventId\": \"evt-{{$guid}}\",\n  \"eventType\": \"BILL_ISSUED\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"bookingRef\": \"{{bookingRef}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"payload\": {\n    \"status\": \"COMPLETED\",\n    \"serviceFee\": {{completedServiceFee}},\n    \"materialCost\": {{materialCost}},\n    \"totalCost\": {{totalCost}},\n    \"billIssuedAt\": \"{{$isoTimestamp}}\"\n  }\n}" },
        "url": { "raw": "{{sbpBaseUrl}}/integration/booking-events", "host": ["{{sbpBaseUrl}}"], "path": ["integration", "booking-events"] }
      }
    },
    {
      "name": "Check A · [SBP] Booking is COMPLETED with technician and bill",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "const expectedTechnicians = JSON.parse(pm.collectionVariables.get('technicians'));",
        "pm.test('status is COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
        "pm.test('technician names match the mock event (Req 3.3.S5)', () => {",
        "  pm.expect(body.technicians.map(t => t.fullName)).to.have.members(expectedTechnicians.map(t => t.fullName));",
        "});",
        "pm.test('total = service fee + material cost, same as the mock event (Req 3.3.S6)', () => {",
        "  pm.expect(body.bill.totalCost).to.eql(body.bill.serviceFee + body.bill.materialCost);",
        "  pm.expect(body.bill.totalCost).to.eql(Number(pm.collectionVariables.get('totalCost')));",
        "});"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{sbpBaseUrl}}/bookings/{{bookingRef}}", "host": ["{{sbpBaseUrl}}"], "path": ["bookings", "{{bookingRef}}"] }
      }
    },
    {
      "name": "Check B · [SBP] Customer was notified of CONFIRMED and SCHEDULED",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "const ref = pm.variables.get('bookingRef');",
        "const types = pm.response.json().items.filter(n => n.bookingRef === ref).map(n => n.type);",
        "console.log('notifications for', ref, types);",
        "pm.test('BOOKING_CONFIRMED and BOOKING_SCHEDULED were sent (Req 3.3.U2)', () => {",
        "  pm.expect(types).to.include('BOOKING_CONFIRMED');",
        "  pm.expect(types).to.include('BOOKING_SCHEDULED');",
        "});"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{sbpBaseUrl}}/notifications?size=50", "host": ["{{sbpBaseUrl}}"], "path": ["notifications"], "query": [{ "key": "size", "value": "50" }] }
      }
    }
  ]
}
