# Backend environment for local runs.
#
#   cp .env.example .env        # then fill in the real values in .env (gitignored)
#   ./mvnw spring-boot:run      # run from Backend/, where .env is read
#
# Loaded by spring.config.import in application.yml. A variable exported in the shell
# overrides the same name here.
#
# Format: KEY=value. No quotes (they become part of the value) and no "export".
# Lines starting with # are ignored; a commented variable keeps the default shown.

# --- Required ---------------------------------------------------------------------
# The two regional Atlas clusters (Req 3.1.U1). Each URI must end with its database
# name before the query string, or startup fails.
MONGO_URI_SOUTH=mongodb+srv://<user>:<password>@<south-cluster>.mongodb.net/sbp_south?retryWrites=true&w=majority
MONGO_URI_NORTH=mongodb+srv://<user>:<password>@<north-cluster>.mongodb.net/sbp_north?retryWrites=true&w=majority

# --- Evidence images (Reqs 3.3.M1, 3.4.M1) -----------------------------------------
# local: written under target/uploads, links are file:// and do not open in a browser.
# cloudinary: uploaded to the account below. Console -> Dashboard (cloud name),
# Settings -> API Keys (key and secret).
IMAGE_STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# IMAGE_LOCAL_DIR=target/uploads

# --- SMP integration ---------------------------------------------------------------
# mock: bookings served from local fixtures, SBP runs alone (Req 4.S2).
# live: catalogue, booking creation and the rating check call SMT's service at
#       SMP_BASE_URL (Req 4.M1). Cancellation is applied inside SBP in both modes
#       until SMT publishes an endpoint for it (LocalCancellationRule).
SMP_MODE=mock
# SMP_BASE_URL=http://localhost:9443/api/v1
# SMP_SERVICE_TOKEN=local-integration-token
# SMP_WEBHOOK_SECRET=dev-only-shared-secret
# Staff have their own switch. live = MockSMP (MockSMP/README.md), never SMT's service.
SMP_STAFF_MODE=mock
# SMP_STAFF_BASE_URL=http://localhost:8090
# SMP_STAFF_SERVICE_TOKEN=dev-only-shared-secret

# --- Google sign-in (Req 3.2.U1) ---------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/login

# --- Profiles and email (Req 3.1.S5) -----------------------------------------------
# SPRING_PROFILES_ACTIVE=dev
# Set SPRING_PROFILES_ACTIVE=dev,smtp to send real email; these are then required.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# EMAIL_FROM_ADDRESS=no-reply@fixinh.vn
# EMAIL_FROM_NAME=Fixinh
# EMAIL_STAFF_SIGN_IN_URL=http://localhost:8081/login
# EMAIL_RETRY_ENABLED=true

# --- Security ----------------------------------------------------------------------
# JWT_SECRET=dev-only-change-me-please-32-bytes-minimum-secret
# JWT_ISSUER=fixinh-sbp
# JWT_ACCESS_TOKEN_TTL_MINUTES=60
# JWT_REFRESH_TOKEN_TTL_DAYS=30
# CORS_ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000

# --- Server and HTTPS (Req A.2.5) --------------------------------------------------
# SERVER_PORT=8443
# SSL_ENABLED=false
# SSL_KEYSTORE=classpath:keystore.p12
# SSL_KEYSTORE_PASSWORD=changeit
# SSL_KEY_ALIAS=sbp
