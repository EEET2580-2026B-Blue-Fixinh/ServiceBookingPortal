<?xml version="1.0" encoding="UTF-8"?>
<!--
	Test-run logging. Applies to `mvn test` only: this file is on the test classpath and
	nowhere else, so nothing here changes how the application logs when it runs.

	Why it exists: most test classes are plain JUnit and never start Spring, so
	`logging.level.*` in application-dev.yml never reaches them. Without a config of its own
	Logback falls back to DEBUG-to-console, and the tests that deliberately provoke a failure
	(a refused email, an exhausted retry, an unwritable shard directory) each print a full
	stack trace for a warning that is really the assertion passing. Real failures get lost
	among them.

	Turn it back on when debugging a test:
	    mvnw test -Dsbp.test.log.level=DEBUG
-->
<configuration>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Our own code. OFF by default because a test asserts on behaviour, not on logs. -->
	<logger name="com.fixinh.sbp" level="${sbp.test.log.level:-OFF}"/>

	<!--
		Spring Boot re-applies logging.level.* from application-dev.yml after this file is
		read, so the line above is overridden back to DEBUG inside the tests that start a full
		context. The two below are not named there, so they hold everywhere.

		WelcomeEmailLoggingTest turns com.fixinh.sbp back on for itself and attaches its own
		appender: proving that a password is never logged needs logging switched on.
	-->
	<logger name="org.springframework" level="WARN"/>
	<logger name="org.mongodb" level="WARN"/>

	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
	</root>

</configuration>